---
import { site } from '../../site.config';
import Icon from './Icon.astro';
const iconFor=(label:string)=>label==='GitHub'?'github':label==='X'?'x':label==='邮箱'?'mail':'arrowUpRight';
---
<footer class="app-layout mt-auto">
  <div class="border-border flex flex-col items-center justify-between border-t py-6 sm:flex-row-reverse sm:py-4">
    <div class="flex flex-wrap items-center gap-1">{site.social.map(item=><a href={item.href} rel="me" class="group p-2 hover:rotate-6 sm:p-1" title={item.label} aria-label={item.label}><Icon name={iconFor(item.label)} size={24}/></a>)}</div>
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row"><span>版权所有 &#169; {new Date().getFullYear()}</span><span class="hidden sm:inline">&nbsp;|&nbsp;</span><span>{site.author.name}</span></div>
  </div>
</footer>
