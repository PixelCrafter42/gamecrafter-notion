---
import{site}from'../../site.config';import BaseLayout from'./BaseLayout.astro';import Breadcrumb from'./Breadcrumb.astro';const{eyebrow,heading,intro,title=`${heading} · ${site.name}`,description=intro}=Astro.props;const section=site.sections.find(item=>`${item.path}/`===Astro.url.pathname)||{navLabel:heading};
---
<BaseLayout {title} {description}>
  <Breadcrumb {section}/>
  <main id="main-content" class="app-layout app-prose pb-4">
    {eyebrow&&<p class="text-muted-foreground mb-1 text-sm">{eyebrow}</p>}
    <h1 class="text-2xl font-semibold sm:text-3xl">{heading}</h1>
    {intro&&<p class="mt-2 mb-6 italic">{intro}</p>}
    <slot/>
  </main>
</BaseLayout>
