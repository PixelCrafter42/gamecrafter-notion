---
import{site}from'../../site.config';import BaseLayout from'./BaseLayout.astro';const{eyebrow,heading,intro,title=`${heading} · ${site.name}`,description=intro}=Astro.props;
---
<BaseLayout {title} {description}><article class="page ap-shell ap-page"><header><p class="ap-kicker">{eyebrow}</p><h1>{heading}</h1>{intro&&<p>{intro}</p>}</header><div class="ap-prose"><slot/></div></article></BaseLayout>
<style>.page{padding-top:3rem}header{margin-bottom:2rem;padding-bottom:1.5rem;border-bottom:1px solid var(--ap-border)}h1{margin:.45rem 0 .7rem;font-size:2.4rem;line-height:1.2}header>p:last-child{margin:0;color:var(--ap-muted)}@media(max-width:640px){.page{padding-top:2rem}h1{font-size:2rem}}</style>
