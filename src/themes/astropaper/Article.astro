---
import{site}from'../../site.config';import BaseLayout from'./BaseLayout.astro';import Icon from'./Icon.astro';const{post,previous,next,section}=Astro.props;const data=post.data;const structuredData={'@context':'https://schema.org','@type':'BlogPosting',headline:data.title,description:data.description,datePublished:data.pubDate.toISOString(),dateModified:(data.updatedDate??data.pubDate).toISOString(),author:{'@type':'Person',name:site.author.name},mainEntityOfPage:new URL(Astro.url.pathname,site.url).toString()};
---
<BaseLayout title={`${data.title} · ${site.name}`} description={data.description} type="article" {structuredData}><article class="article ap-shell ap-page"><header><h1>{data.title}</h1><p class="description">{data.description}</p><div class="meta"><Icon name="calendar" size={16}/><time datetime={data.pubDate.toISOString()}>{data.pubDate.toLocaleDateString('zh-CN',{year:'numeric',month:'short',day:'numeric'})}</time>{data.tags.map((tag:string)=><span>#{tag}</span>)}</div></header><div class="ap-prose"><slot/></div></article><nav class="post-nav ap-shell" aria-label="文章导航"><div>{previous&&<><small>上一篇</small><a href={`${section.path}/${previous.id}/`}><Icon name="arrowLeft" size={16}/>{previous.data.title}</a></>}</div><div>{next&&<><small>下一篇</small><a href={`${section.path}/${next.id}/`}>{next.data.title}<Icon name="arrowRight" size={16}/></a></>}</div></nav></BaseLayout>
<style>.article{padding-top:3rem}header{margin-bottom:2rem;padding-bottom:1.5rem;border-bottom:1px solid var(--ap-border)}h1{margin:0 0 .8rem;font-size:clamp(2.1rem,7vw,2.75rem);line-height:1.2;letter-spacing:-.035em}.description{margin:.4rem 0;color:var(--ap-muted)}.meta{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem .75rem;margin-top:1rem;color:var(--ap-muted);font-size:.82rem}.post-nav{display:grid;grid-template-columns:1fr 1fr;gap:1rem;padding-top:1rem;padding-bottom:2rem}.post-nav div:last-child{text-align:right}.post-nav small{display:block;color:var(--ap-muted)}.post-nav a{display:inline-flex;align-items:center;gap:.3rem;color:var(--ap-accent)}@media(max-width:640px){.article{padding-top:2rem}.post-nav{grid-template-columns:1fr}.post-nav div:last-child{text-align:left}}</style>
