---
import {site} from '../../site.config';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from './Breadcrumb.astro';
import PostCard from './PostCard.astro';
const{posts,section}=Astro.props;
---
<BaseLayout title={`${section.navLabel} · ${site.name}`} description={section.description||`${site.name} 的${section.navLabel}内容。`}>
  <Breadcrumb {section} pageNumber={1}/>
  <main id="main-content" class="app-layout pb-4" data-list-page data-back-url={`${section.path}/`}>
    <h1 class="text-2xl font-semibold sm:text-3xl">{section.heading}</h1>
    <p class="mt-2 mb-6 italic">{section.description||`共 ${posts.length} 篇，按发布时间排序。`}</p>
    <ul>{posts.map(post=><PostCard {post}/>)}</ul>
    {!posts.length&&<p class="text-muted-foreground">还没有公开内容。</p>}
  </main>
</BaseLayout>
<script>const remember=()=>{const list=document.querySelector<HTMLElement>('[data-list-page]');if(list?.dataset.backUrl)sessionStorage.setItem('backUrl',list.dataset.backUrl)};remember();document.addEventListener('astro:page-load',remember);</script>
