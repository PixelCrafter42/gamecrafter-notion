---
import{site}from'../../site.config';import BaseLayout from'./BaseLayout.astro';import ProjectCard from'./ProjectCard.astro';const{projects,section}=Astro.props;
---
<BaseLayout title={`${section.navLabel} · ${site.name}`} description={section.description}><div class="projects ap-shell ap-page"><header><h1>{section.heading}</h1>{section.description&&<p>{section.description}</p>}</header>{projects.length?<ul>{projects.map(project=><ProjectCard {project}/>)}</ul>:<p class="ap-empty">还没有公开项目。</p>}</div></BaseLayout>
<style>.projects{padding-top:3rem}header{margin-bottom:2.5rem}h1{margin:0 0 .6rem;font-size:2.35rem}header p{margin:0;color:var(--ap-muted)}ul{margin:0;padding:0;list-style:none}@media(max-width:640px){.projects{padding-top:2rem}h1{font-size:2rem}}</style>
