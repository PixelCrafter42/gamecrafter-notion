---
import{site}from'../../site.config';import BaseLayout from'./BaseLayout.astro';import Icon from'./Icon.astro';const{project,section}=Astro.props;const data=project.data;const structuredData={'@context':'https://schema.org','@type':'CreativeWork',name:data.title,description:data.description,datePublished:data.pubDate.toISOString(),author:{'@type':'Person',name:site.author.name},mainEntityOfPage:new URL(Astro.url.pathname,site.url).toString()};
---
<BaseLayout title={`${data.title} · ${site.name}`} description={data.description} {structuredData}><article class="project ap-shell ap-page"><header><h1>{data.title}</h1><p>{data.description}</p><div class="meta">{data.projectType&&<span>{data.projectType}</span>}{data.projectStatus&&<span>{data.projectStatus}</span>}<time datetime={data.pubDate.toISOString()}>{data.pubDate.toLocaleDateString('zh-CN')}</time></div>{(data.projectUrl||data.repository)&&<div class="actions">{data.projectUrl&&<a href={data.projectUrl}>访问项目 <Icon name="arrowUpRight" size={16}/></a>}{data.repository&&<a href={data.repository}>代码仓库 <Icon name="arrowUpRight" size={16}/></a>}</div>}</header>{data.cover&&<img class="cover" src={data.cover} alt=""/>}<div class="ap-prose"><slot/></div></article><div class="back ap-shell"><a href={`${section.path}/`}><Icon name="arrowLeft" size={16}/> 返回{section.navLabel}</a></div></BaseLayout>
<style>.project{padding-top:3rem}header{margin-bottom:2rem;padding-bottom:1.5rem;border-bottom:1px solid var(--ap-border)}h1{margin:0 0 .7rem;font-size:2.6rem}header>p{color:var(--ap-muted)}.meta,.actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1rem;font-size:.84rem}.actions a,.back a{display:inline-flex;align-items:center;gap:.25rem;color:var(--ap-accent)}.cover{display:block;margin-bottom:2rem;border:1px solid var(--ap-border)}.back{padding-bottom:2rem}@media(max-width:640px){.project{padding-top:2rem}h1{font-size:2.1rem}}</style>
