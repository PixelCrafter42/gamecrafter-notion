---
import{site}from'../../site.config';import BaseLayout from'./BaseLayout.astro';import BackButton from'./BackButton.astro';import Icon from'./Icon.astro';const{project,section}=Astro.props;const data=project.data;const transitionName=`project-${String(project.id).replace(/[^a-zA-Z0-9_-]/g,'-')}`;const structuredData={'@context':'https://schema.org','@type':'CreativeWork',name:data.title,description:data.description,datePublished:data.pubDate.toISOString(),author:{'@type':'Person',name:site.author.name},mainEntityOfPage:new URL(Astro.url.pathname,site.url).toString()};
---
<BaseLayout title={`${data.title} · ${site.name}`} description={data.description} {structuredData}><BackButton href={`${section.path}/`} label="返回"/><main id="main-content" class="project app-layout"><header><h1 style={{viewTransitionName:transitionName}}>{data.title}</h1><p>{data.description}</p><div class="meta">{data.projectType&&<span>{data.projectType}</span>}{data.projectStatus&&<span>{data.projectStatus}</span>}<time datetime={data.pubDate.toISOString()}>{data.pubDate.toLocaleDateString('zh-CN')}</time></div>{(data.projectUrl||data.repository)&&<div class="actions">{data.projectUrl&&<a href={data.projectUrl}>访问项目 <Icon name="arrowUpRight" size={16}/></a>}{data.repository&&<a href={data.repository}>代码仓库 <Icon name="arrowUpRight" size={16}/></a>}</div>}</header>{data.cover&&<img class="cover" src={data.cover} alt=""/>}<article class="app-prose max-w-app"><slot/></article></main></BaseLayout>
<style>.project{padding-bottom:2rem}header{margin-bottom:2rem}h1{display:inline-block;margin:0;color:var(--ap-accent);font-size:1.875rem}header>p{color:var(--ap-muted)}.meta,.actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1rem;font-size:.84rem}.actions a{display:inline-flex;align-items:center;gap:.25rem;color:var(--ap-accent)}.cover{display:block;margin-bottom:2rem;border:1px solid var(--ap-border)}@media(max-width:640px){h1{font-size:1.5rem}}</style>
