---
import Icon from'./Icon.astro';const{thought,detail=false}=Astro.props;const data=thought.data;const base=data.modulePath==='/'?'':data.modulePath;const href=`${base}/${thought.id}/`;const transitionName=`thought-${String(thought.id).replace(/[^a-zA-Z0-9_-]/g,'-')}`;
---
<article class:list={['thought',{detail}]}><div class="date"><Icon name="calendar" size={16}/><time datetime={data.pubDate.toISOString()}>{data.pubDate.toLocaleString('zh-CN',data.publishedHasTime?{year:'numeric',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}:{year:'numeric',month:'short',day:'numeric'})}</time></div>{detail?<h1 style={{viewTransitionName:transitionName}}>{data.title}</h1>:<a class="title" href={href}><h2 style={{viewTransitionName:transitionName}}>{data.title}</h2></a>}{data.description&&data.description!==data.title&&<p>{data.description}</p>}{detail&&data.html&&<div class="app-prose max-w-app body" set:html={data.html}/>} {!detail&&<a class="more" href={href}>打开 <Icon name="arrowUpRight" size={15}/></a>}</article>
<style>.thought{margin:1.8rem 0}.date{display:flex;align-items:center;gap:.4rem;color:var(--ap-muted);font-size:.82rem}.title{display:inline-block;color:var(--ap-accent);text-decoration:none}.title:hover{text-decoration:underline dashed}h1,h2{margin:.35rem 0;font-size:1.15rem;line-height:1.45}h1{font-size:2.35rem}p{margin:.3rem 0}.more{display:inline-flex;align-items:center;gap:.2rem;margin-top:.45rem;font-size:.82rem}.body{margin-top:1.5rem}</style>
