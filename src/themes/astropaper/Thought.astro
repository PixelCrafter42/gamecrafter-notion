---
import{site}from'../../site.config';import BaseLayout from'./BaseLayout.astro';import BackButton from'./BackButton.astro';import ThoughtCard from'./ThoughtCard.astro';const{thought,section}=Astro.props;
---
<BaseLayout title={`${thought.data.title} · ${site.name}`} description={thought.data.description}><BackButton href={`${section.path}/`} label="返回"/><main id="main-content" class="detail app-layout pb-4"><ThoughtCard {thought} detail/></main></BaseLayout>
<style>.detail{padding-bottom:1rem}</style>
