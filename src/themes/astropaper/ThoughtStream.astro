---
import{site}from'../../site.config';import BaseLayout from'./BaseLayout.astro';import ThoughtCard from'./ThoughtCard.astro';const{thoughts,section}=Astro.props;
---
<BaseLayout title={`${section.navLabel} · ${site.name}`} description={section.description}><div class="thoughts ap-shell ap-page"><header><h1>{section.heading}</h1>{section.description&&<p>{section.description}</p>}</header><section aria-label={section.navLabel}>{thoughts.map(thought=><ThoughtCard {thought}/>)}</section>{!thoughts.length&&<p class="ap-empty">还没有公开想法。</p>}</div></BaseLayout>
<style>.thoughts{padding-top:3rem}header{margin-bottom:2.5rem}h1{margin:0 0 .6rem;font-size:2.35rem}header p{margin:0;color:var(--ap-muted)}@media(max-width:640px){.thoughts{padding-top:2rem}h1{font-size:2rem}}</style>
