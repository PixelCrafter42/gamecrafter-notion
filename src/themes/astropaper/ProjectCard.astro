---
import Icon from'./Icon.astro';const{project}=Astro.props;const data=project.data;const base=data.modulePath==='/'?'':data.modulePath;const transitionName=`project-${String(project.id).replace(/[^a-zA-Z0-9_-]/g,'-')}`;
---
<li class="project-card">{data.cover&&<a class="cover" href={`${base}/${project.id}/`}><img src={data.cover} alt="" loading="lazy"/></a>}<div><a class="title" href={`${base}/${project.id}/`}><h2 style={{viewTransitionName:transitionName}}>{data.title}</h2></a><p class="meta">{data.projectType||'项目'}{data.projectStatus&&` · ${data.projectStatus}`}</p><p>{data.description}</p><a class="more" href={`${base}/${project.id}/`}>查看项目 <Icon name="arrowUpRight" size={16}/></a></div></li>
<style>.project-card{display:grid;grid-template-columns:9rem 1fr;gap:1.1rem;margin:1.8rem 0}.cover{display:block}.cover img{width:100%;aspect-ratio:16/10;object-fit:cover;border:1px solid var(--ap-border)}.title{display:inline-block;color:var(--ap-accent);text-decoration:none}.title:hover{text-decoration:underline dashed}.title h2{margin:0;font-size:1.16rem}.meta{color:var(--ap-muted);font-size:.8rem}.project-card p{margin:.3rem 0}.more{display:inline-flex;align-items:center;gap:.2rem;margin-top:.4rem;font-size:.85rem}@media(max-width:520px){.project-card{grid-template-columns:1fr}.cover img{max-width:15rem}}</style>
