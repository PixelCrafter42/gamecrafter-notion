---
import IconCalendar from './icons/IconCalendar.svg';
const {post}=Astro.props;const data=post.data;const base=data.modulePath==='/'?'':data.modulePath;const href=`${base}/${post.id}/`;const transitionName=`post-${String(post.id).replace(/[^a-zA-Z0-9_-]/g,'-')}`;
---
<li class="my-6">
  <a href={href} class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline focus-visible:underline-offset-0"><h2 style={{viewTransitionName:transitionName}}>{data.title}</h2></a>
  <div class="text-muted-foreground flex items-center gap-x-2"><IconCalendar class="inline-block size-6 min-w-5.5 scale-90"/><time class="text-sm" datetime={data.pubDate.toISOString()}>{data.pubDate.toLocaleDateString('zh-CN',{year:'numeric',month:'short',day:'numeric'})}</time></div>
  {data.description&&<p>{data.description}</p>}
</li>
