---
import Icon from './Icon.astro';
const { thought, compact = false, detail = false } = Astro.props;
const data = thought.data;
const base = data.modulePath === '/' ? '' : data.modulePath;
const href = `${base}/${thought.id}/`;
const dateOptions: Intl.DateTimeFormatOptions = data.publishedHasTime
  ? {year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hour12:false}
  : {year:'numeric',month:'2-digit',day:'2-digit'};
const displayDate = data.pubDate.toLocaleString('zh-CN',dateOptions);
---
<article class:list={['thought', {compact,detail}]} id={detail ? undefined : thought.id}>
  <header>
    <a class="time" href={href}><time datetime={data.pubDate.toISOString()}>{displayDate}</time></a>
    {data.tags.length > 0 && <div class="tags">{data.tags.map((tag:string)=><span>#{tag}</span>)}</div>}
  </header>
  {detail ? <h1>{data.title}</h1> : <h2><a href={href}>{data.title}</a></h2>}
  {data.description && data.description !== data.title && <p class="summary">{data.description}</p>}
  {!compact && data.html && <div class="body prose" set:html={data.html} />}
  {!detail && <a class="permalink" href={href} aria-label={`打开想法：${data.title}`}>永久链接 <Icon name="arrowUpRight" size="sm" /></a>}
</article>
<style>
  .thought { position:relative; padding:2rem 0 2.2rem; border-top:1px solid var(--line); }
  .thought:last-child { border-bottom:1px solid var(--line); }
  header { display:flex; flex-wrap:wrap; align-items:center; gap:.7rem 1rem; margin-bottom:.75rem; }
  .time { color:var(--accent); font:.75rem ui-monospace,monospace; letter-spacing:.02em; text-decoration:none; }
  .tags { display:flex; flex-wrap:wrap; gap:.45rem; color:var(--muted); font-size:.75rem; }
  h1, h2 { margin:0; max-width:42rem; font-size:clamp(1.15rem,2.4vw,1.45rem); line-height:1.55; letter-spacing:-.02em; font-weight:600; }
  h2 a { color:inherit; text-decoration:none; }
  h2 a:hover { color:var(--accent); }
  .summary { margin:.55rem 0 0; max-width:42rem; color:var(--muted); line-height:1.7; }
  .body { margin-top:1rem; }
  .permalink { display:inline-flex; align-items:center; gap:.2rem; margin-top:1.1rem; color:var(--muted); font-size:.78rem; text-decoration:none; }
  .permalink:hover { color:var(--ink); }
  .compact { padding:1.25rem 0 1.4rem; }
  .compact h2 { font-size:1.08rem; }
  .detail { padding-top:0; border-top:0; }
  @media(max-width:40rem) { .thought { padding:1.5rem 0 1.7rem; } }
</style>
