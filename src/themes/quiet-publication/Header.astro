---
import { site } from '../../site.config';
import Icon from './Icon.astro';
const links = site.sections
  .filter(section => section.showInNav)
  .sort((a,b) => a.navOrder - b.navOrder)
  .map(section => ({href:section.path === '/' ? '/' : `${section.path}/`,label:section.navLabel}));
---
<header class="site-header container">
  <a class="brand" href="/" aria-label={`${site.name} 首页`}>
    {site.avatar && <img src={site.avatar.src} alt="" width="36" height="36" />}
    <span>{site.name}</span>
  </a>
  <nav aria-label="主导航">{links.map(item => <a href={item.href}>{item.label}</a>)}</nav>
  <div class="header-actions">
    {site.features.rss && <a class="icon-action rss" href="/rss.xml" aria-label="订阅 RSS">RSS</a>}
    {site.features.theme && <button class="icon-action" data-theme-toggle aria-label="切换明暗主题"><Icon name="theme" /></button>}
  </div>
</header>
<style>
  .site-header { display:flex; align-items:center; gap:2rem; min-height:5rem; border-bottom:1px solid var(--line); }
  .brand { display:inline-flex; align-items:center; gap:.65rem; font-weight:800; text-decoration:none; letter-spacing:-.04em; font-size:1.2rem; }
  .brand img { width:2.25rem; height:2.25rem; border-radius:50%; object-fit:cover; border:1px solid var(--line); }
  nav { display:flex; flex-wrap:wrap; gap:1rem; flex:1; }
  nav a { color:var(--muted); text-decoration:none; font-size:.9rem; }
  nav a:hover { color:var(--ink); }
  .header-actions { display:flex; gap:.35rem; align-items:center; }
  .icon-action { display:inline-grid; place-items:center; min-width:2.25rem; height:2.25rem; padding:0 .4rem; border:1px solid transparent; border-radius:50%; background:transparent; color:var(--muted); text-decoration:none; cursor:pointer; transition:color .15s ease, border-color .15s ease, background .15s ease; }
  .icon-action:hover { color:var(--ink); border-color:var(--line); background:var(--soft); }
  .rss { font:700 .7rem ui-monospace, monospace; }
  @media (max-width: 40rem) { .site-header { flex-wrap:wrap; gap:.75rem 1rem; padding:1rem 0; } nav { order:3; flex-basis:100%; } }
</style>
<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const current = document.documentElement.dataset.theme;
    const dark = current === 'dark' || (current === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
    const next = dark ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('quiet-publication-theme', next); } catch {}
  });
</script>
