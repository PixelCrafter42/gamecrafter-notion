---
import { site } from '../../site.config';
import BaseLayout from './BaseLayout.astro';
import ThoughtCard from './ThoughtCard.astro';
const { thoughts, section } = Astro.props;
---
<BaseLayout title={`${section.navLabel} · ${site.name}`} description={section.description}>
  <header class="page-head narrow">
    <p class="eyebrow">{section.eyebrow}</p>
    <h1>{section.heading}</h1>
    {section.description && <p>{section.description}</p>}
  </header>
  <section class="stream narrow" aria-label={section.navLabel}>
    {thoughts.length > 0 ? thoughts.map(thought=><ThoughtCard thought={thought} />) : <p class="empty">还没有公开想法。</p>}
  </section>
</BaseLayout>
<style>
  .page-head { padding:3.5rem 0 2rem; }
  .page-head h1 { margin:.5rem 0 .8rem; max-width:42rem; font-size:clamp(2rem,4vw,3.2rem); line-height:1.12; letter-spacing:-.045em; }
  .page-head > p:last-child, .empty { color:var(--muted); }
  .stream { padding-bottom:5rem; }
</style>
