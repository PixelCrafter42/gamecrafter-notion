---
import { site } from '../../site.config';
import BaseLayout from './BaseLayout.astro';
import Icon from './Icon.astro';
import PostCard from './PostCard.astro';
import ProjectCard from './ProjectCard.astro';
import { quietPublicationTheme } from './theme.config';
const { posts, projects = [] } = Astro.props;
const featuredProjects = [...projects].sort((a,b)=>Number(b.data.featured)-Number(a.data.featured) || b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,3);
const heroStyle = [
  `--hero-spacing:${quietPublicationTheme.homeIntro.spacing}`,
  `--hero-lede-size:${quietPublicationTheme.homeIntro.ledeSize}`,
].join(';');
---
<BaseLayout>
  <section class="hero container" style={heroStyle}>
    <p class="lede">{site.description}</p>
    <p class="author">{site.author.bio}</p>
  </section>
  <section class="container">
    <div class="section-heading"><h2><span>01 /</span> {site.pages.home.writingTitle}</h2><a href="/blog/">全部 {posts.length} 篇 <Icon name="arrowRight" size="sm" /></a></div>
    <p class="eyebrow sub">最近更新</p>
    {posts.length > 0 ? <div class="list">{posts.slice(0, 5).map(post => <PostCard post={post} />)}</div> : <p class="empty">还没有公开文章。</p>}
  </section>
  {site.features.projects && <section class="container">
    <div class="section-heading"><h2><span>02 /</span> {site.navigation.projects}</h2><a href="/projects/">全部 {projects.length} 个 <Icon name="arrowRight" size="sm" /></a></div>
    {featuredProjects.length > 0 ? <div class="project-grid">{featuredProjects.map(project => <ProjectCard project={project} compact />)}</div> : <p class="empty">还没有公开项目。</p>}
  </section>}
  {site.features.about && <section class="start container">
    <p class="eyebrow">{site.features.projects ? '03' : '02'} / {site.navigation.about}</p>
    <h2>{site.pages.home.aboutTitle}</h2>
    <p>{site.pages.home.aboutDescription}</p>
    <a href="/about/">了解更多 <Icon name="arrowRight" size="sm" /></a>
  </section>}
</BaseLayout>
<style>
  .hero { padding:var(--hero-spacing); }
  .lede { font-size:var(--hero-lede-size); max-width:45rem; line-height:1.35; margin:0; }
  .author { margin:.4rem 0 0; }
  .author, .empty { color:var(--muted); max-width:40rem; }
  .hero + section :global(.section-heading) { margin-top:3rem; }
  .section-heading span { color:var(--accent); font-size:.8rem; font-family:ui-monospace,monospace; }
  .sub { margin-top:2rem; }
  .start { margin-top:5rem; padding:3rem 0; border-block:1px solid var(--line); }
  .start h2 { font-size:clamp(2rem,5vw,4rem); margin:.4rem 0; letter-spacing:-.05em; }
  .project-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; margin-top:1rem; }
  @media(max-width:48rem) { .project-grid { grid-template-columns:1fr; } }
</style>
