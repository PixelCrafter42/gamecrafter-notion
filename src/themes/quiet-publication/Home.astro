---
import { site } from '../../site.config';
import BaseLayout from './BaseLayout.astro';
import Icon from './Icon.astro';
import PostCard from './PostCard.astro';
import ProjectCard from './ProjectCard.astro';
import ThoughtCard from './ThoughtCard.astro';
import { quietPublicationTheme } from './theme.config';
const { posts, projects = [] } = Astro.props;
const homeSections = site.sections.filter(section => section.showOnHome && section.key !== 'home').sort((a,b)=>a.navOrder-b.navOrder);
const allContent = [...posts, ...projects];
const contentFor = section => allContent
  .filter(item => item.data.moduleKey === section.key)
  .sort((a,b)=>Number(b.data.featured)-Number(a.data.featured) || b.data.pubDate.valueOf()-a.data.pubDate.valueOf())
  .slice(0, section.homeLimit || (section.layout === '项目网格' ? 3 : 5));
const heroStyle = [
  `--hero-spacing:${quietPublicationTheme.homeIntro.spacing}`,
  `--hero-lede-size:${quietPublicationTheme.homeIntro.ledeSize}`,
].join(';');
---
<BaseLayout>
  <section class="hero container" style={heroStyle}>
    <p class="lede">{site.description}</p>
    <p class="author">{site.author.bio}</p>
  </section>
  {homeSections.map((section,index) => {
    const items = contentFor(section);
    const count = allContent.filter(item => item.data.moduleKey === section.key).length;
    const number = String(index + 1).padStart(2,'0');
    if (section.layout === '普通页面') return <section class="start container">
      <p class="eyebrow">{number} / {section.navLabel}</p>
      <h2>{section.homeTitle || section.heading}</h2>
      <p>{section.homeDescription || section.description}</p>
      <a href={`${section.path}/`}>了解更多 <Icon name="arrowRight" size="sm" /></a>
    </section>;
    if (section.layout === '项目网格') return <section class="container">
      <div class="section-heading"><h2><span>{number} /</span> {section.homeTitle || section.navLabel}</h2><a href={`${section.path}/`}>全部 {count} 个 <Icon name="arrowRight" size="sm" /></a></div>
      {items.length > 0 ? <div class="project-grid">{items.map(project => <ProjectCard project={project} compact />)}</div> : <p class="empty">还没有公开内容。</p>}
    </section>;
    if (section.layout === '动态流') return <section class="container">
      <div class="section-heading"><h2><span>{number} /</span> {section.homeTitle || section.navLabel}</h2><a href={`${section.path}/`}>全部 {count} 条 <Icon name="arrowRight" size="sm" /></a></div>
      {items.length > 0 ? <div class="thought-preview">{items.map(thought => <ThoughtCard thought={thought} compact />)}</div> : <p class="empty">还没有公开想法。</p>}
    </section>;
    return <section class="container">
      <div class="section-heading"><h2><span>{number} /</span> {section.homeTitle || section.navLabel}</h2><a href={`${section.path}/`}>全部 {count} 篇 <Icon name="arrowRight" size="sm" /></a></div>
      <p class="eyebrow sub">最近更新</p>
      {items.length > 0 ? <div class="list">{items.map(post => <PostCard post={post} />)}</div> : <p class="empty">还没有公开内容。</p>}
    </section>;
  })}
</BaseLayout>
<style>
  .hero { padding:var(--hero-spacing); }
  .lede { font-size:var(--hero-lede-size); max-width:45rem; line-height:1.35; margin:0; }
  .author { margin:.4rem 0 0; }
  .author, .empty { color:var(--muted); max-width:40rem; }
  .hero + section :global(.section-heading) { margin-top:3rem; }
  .section-heading span { color:var(--accent); font-size:.8rem; font-family:ui-monospace,monospace; }
  .sub { margin-top:2rem; }
  .start { margin-top:5rem; padding:3rem 0; border-block:1px solid var(--line); }
  .start h2 { font-size:clamp(2rem,5vw,4rem); margin:.4rem 0; letter-spacing:-.05em; }
  .project-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; margin-top:1rem; }
  .thought-preview { max-width:46rem; }
  @media(max-width:48rem) { .project-grid { grid-template-columns:1fr; } }
</style>
