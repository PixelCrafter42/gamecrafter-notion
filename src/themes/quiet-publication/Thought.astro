---
import { site } from '../../site.config';
import BaseLayout from './BaseLayout.astro';
import Icon from './Icon.astro';
import ThoughtCard from './ThoughtCard.astro';
const { thought, section } = Astro.props;
---
<BaseLayout title={`${thought.data.title} · ${site.name}`} description={thought.data.description || thought.data.title} type="article">
  <main class="thought-page narrow">
    <ThoughtCard thought={thought} detail />
    <a class="back" href={`${section.path}/`}><Icon name="arrowLeft" size="sm" /> 返回{section.navLabel}</a>
  </main>
</BaseLayout>
<style>
  .thought-page { padding:5rem 0; }
  .back { display:inline-flex; align-items:center; gap:.25rem; margin-top:2rem; color:var(--muted); text-decoration:none; }
  .back:hover { color:var(--text); }
</style>
