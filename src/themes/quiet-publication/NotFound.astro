---
import BaseLayout from './BaseLayout.astro';
---
<BaseLayout title="页面未找到 · Craft4Fun" description="链接可能已更改，或文章还在草稿里。">
  <section class="missing container">
    <p class="eyebrow">404</p>
    <h1>这页还没有写下。</h1>
    <p>链接可能已更改，或文章还在草稿里。</p>
    <a href="/">返回首页</a>
  </section>
</BaseLayout>
<style>
  .missing { padding:clamp(5rem,14vw,10rem) 0; }
  .missing h1 { font-size:clamp(2.2rem,6vw,4.5rem); line-height:1.05; letter-spacing:-.05em; margin:.5rem 0 1.5rem; }
  .missing p:not(.eyebrow) { color:var(--muted); }
</style>
