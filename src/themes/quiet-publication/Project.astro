---
import { site } from '../../site.config';
import BaseLayout from './BaseLayout.astro';
import Icon from './Icon.astro';
const { project, section } = Astro.props;
const data = project.data;
const structuredData = {
  '@context':'https://schema.org','@type':'CreativeWork',name:data.title,description:data.description,
  datePublished:data.pubDate.toISOString(),author:{'@type':'Person',name:site.author.name},
  mainEntityOfPage:new URL(Astro.url.pathname,site.url).toString(),
};
---
<BaseLayout title={`${data.title} · ${site.name}`} description={data.description} structuredData={structuredData}>
  <article class="project narrow">
    <header>
      <p class="eyebrow">{section.eyebrow}{data.projectStatus && ` · ${data.projectStatus}`}</p>
      <h1>{data.title}</h1>
      <p class="dek">{data.description}</p>
      <div class="meta">{data.projectType && <span>{data.projectType} · </span>}<time datetime={data.pubDate.toISOString()}>{data.pubDate.toLocaleDateString('zh-CN')}</time></div>
      {data.tags.length > 0 && <div class="tags">{data.tags.map((tag: string) => <span class="tag">#{tag}</span>)}</div>}
      {(data.projectUrl || data.repository) && <div class="actions">
        {data.projectUrl && <a href={data.projectUrl} rel="noopener noreferrer">访问项目 <Icon name="arrowUpRight" size="sm" /></a>}
        {data.repository && <a href={data.repository} rel="noopener noreferrer">代码仓库 <Icon name="arrowUpRight" size="sm" /></a>}
      </div>}
    </header>
    {data.cover && <figure class="hero"><img src={data.cover} alt="" /></figure>}
    <div class="prose"><slot /></div>
  </article>
  <div class="narrow all"><a href={`${section.path}/`}>查看全部{section.navLabel}</a></div>
</BaseLayout>
<style>
  .project { padding:5rem 0; }
  .project h1 { font-size:clamp(2.8rem,7vw,5.4rem); line-height:1; letter-spacing:-.06em; margin:.6rem 0 1.2rem; }
  .dek { font-size:1.25rem; color:var(--muted); }
  header { padding-bottom:2.5rem; border-bottom:1px solid var(--line); margin-bottom:2.5rem; }
  .actions { display:flex; flex-wrap:wrap; gap:1rem; margin-top:1.5rem; }
  .actions a { display:inline-flex; gap:.25rem; align-items:center; font-weight:700; }
  .hero { margin:0 0 2.5rem; }
  .hero img { width:100%; height:auto; display:block; }
  .all { margin-top:2rem; }
  .all a { color:var(--muted); }
</style>
