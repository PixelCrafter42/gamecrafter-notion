---
import { site } from '../../site.config';
import BaseLayout from './BaseLayout.astro';
const { eyebrow, heading, intro, title = `${heading} · ${site.name}`, description = intro } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <article class="page narrow">
    <header><p class="eyebrow">{eyebrow}</p><h1>{heading}</h1>{intro && <p>{intro}</p>}</header>
    <div class="prose"><slot /></div>
  </article>
</BaseLayout>
<style>
  .page { padding:5rem 0; }
  .page header { padding-bottom:2rem; border-bottom:1px solid var(--line); margin-bottom:2.5rem; }
  .page h1 { font-size:clamp(2rem,4.5vw,3.5rem); line-height:1.08; letter-spacing:-.045em; margin:.5rem 0 1rem; }
  .page header p:last-child { color:var(--muted); font-size:1.15rem; }
</style>
