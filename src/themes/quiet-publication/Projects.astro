---
import { site } from '../../site.config';
import BaseLayout from './BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
const { projects } = Astro.props;
---
<BaseLayout title={`${site.navigation.projects} · ${site.name}`} description={site.pages.projects.description}>
  <header class="page-head container">
    <p class="eyebrow">{site.pages.projects.eyebrow}</p>
    <h1>{site.pages.projects.title}</h1>
    {site.pages.projects.description && <p>{site.pages.projects.description}</p>}
  </header>
  <section class="container list">
    {projects.length > 0 ? projects.map(project => <ProjectCard project={project} />) : <p class="empty">还没有公开项目。</p>}
  </section>
</BaseLayout>
<style>
  .page-head { padding:5rem 0 2rem; }
  .page-head h1 { font-size:clamp(2.8rem,7vw,5.5rem); line-height:1.02; letter-spacing:-.06em; max-width:55rem; margin:.5rem 0; }
  .page-head > p:last-child, .empty { color:var(--muted); }
</style>
