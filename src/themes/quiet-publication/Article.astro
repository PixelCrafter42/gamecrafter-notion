---
import { site } from '../../site.config';
import BaseLayout from './BaseLayout.astro';
import Icon from './Icon.astro';
const { post, previous, next, section } = Astro.props;
const data = post.data;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: { '@type': 'Person', name: site.author.name },
  mainEntityOfPage: new URL(Astro.url.pathname, site.url).toString(),
};
---
<BaseLayout title={`${data.title} · ${site.name}`} description={data.description} type="article" structuredData={structuredData}>
  <article class="article narrow">
    <header>
      <p class="eyebrow">{section.eyebrow}</p>
      <h1>{data.title}</h1>
      <p class="dek">{data.description}</p>
      <div class="meta">
        <time datetime={data.pubDate.toISOString()}>发布于 {data.pubDate.toLocaleDateString('zh-CN')}</time>
        {data.updatedDate && <> · 更新于 {data.updatedDate.toLocaleDateString('zh-CN')}</>}
      </div>
      {data.tags.length > 0 && <div class="tags">{data.tags.map((tag: string) => <span class="tag">#{tag}</span>)}</div>}
    </header>
    <div class="prose"><slot /></div>
  </article>
  <nav class="post-nav narrow" aria-label="文章导航">
    <div>{previous && <><span>上一篇</span><a href={`${section.path}/${previous.id}/`}><Icon name="arrowLeft" size="sm" /> {previous.data.title}</a></>}</div>
    <div>{next && <><span>下一篇</span><a href={`${section.path}/${next.id}/`}>{next.data.title} <Icon name="arrowRight" size="sm" /></a></>}</div>
  </nav>
  <div class="narrow all"><a href={`${section.path}/`}>查看全部{section.navLabel}</a></div>
</BaseLayout>
<style>
  .article { padding:5rem 0; }
  .article h1 { font-size:clamp(2rem,4.8vw,3.7rem); line-height:1.08; letter-spacing:-.045em; margin:.6rem 0 1.2rem; }
  .dek { font-size:1.25rem; color:var(--muted); }
  .article header { padding-bottom:2.5rem; border-bottom:1px solid var(--line); margin-bottom:2.5rem; }
  .post-nav { display:grid; grid-template-columns:1fr 1fr; gap:2rem; border-top:1px solid var(--line); padding-top:2rem; margin-top:4rem; }
  .post-nav div:last-child { text-align:right; }
  .post-nav span { display:block; color:var(--muted); font-size:.8rem; }
  .post-nav a { font-weight:700; }
  .all { margin-top:2rem; }
  .all a { color:var(--muted); }
  @media(max-width:40rem) { .post-nav { grid-template-columns:1fr; } .post-nav div:last-child { text-align:left; } }
</style>
