---
const { name, size = 'md', label } = Astro.props;
const paths = {
  theme: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"/>',
  arrowRight: '<path d="M4 12h15M13 6l6 6-6 6"/>',
  arrowUpRight: '<path d="M5 19 19 5M9 5h10v10"/>',
  arrowLeft: '<path d="M20 12H5M11 6l-6 6 6 6"/>',
};
const path = paths[name as keyof typeof paths] ?? paths.arrowRight;
---
<svg class={`icon icon-${size}`} viewBox="0 0 24 24" fill="none" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} focusable="false">
  <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={path} />
</svg>
<style>
  .icon { display:inline-block; flex:0 0 auto; width:var(--icon-size-md); height:var(--icon-size-md); vertical-align:-.18em; }
  .icon-sm { width:var(--icon-size-sm); height:var(--icon-size-sm); }
  .icon-lg { width:var(--icon-size-lg); height:var(--icon-size-lg); }
</style>
