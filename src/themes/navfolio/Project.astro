---
import { site } from '../../site.config';
import BaseLayout from './BaseLayout.astro';
import Icon from './Icon.astro';
const { project,section }=Astro.props;
const data=project.data;
const structuredData={'@context':'https://schema.org','@type':'CreativeWork',name:data.title,description:data.description,datePublished:data.pubDate.toISOString(),author:{'@type':'Person',name:site.author.name},mainEntityOfPage:new URL(Astro.url.pathname,site.url).toString()};
---
<BaseLayout title={`${data.title} · ${site.name}`} description={data.description} structuredData={structuredData}>
  <article class="project nf-reading nf-card"><header><p class="nf-kicker">{section.eyebrow}{data.projectStatus&&` · ${data.projectStatus}`}</p><h1>{data.title}</h1><p class="dek">{data.description}</p><div class="meta">{data.projectType&&<span>{data.projectType}</span>}<time datetime={data.pubDate.toISOString()}>{data.pubDate.toLocaleDateString('zh-CN')}</time>{data.tags.map((tag:string)=><span>#{tag}</span>)}</div>{(data.projectUrl||data.repository)&&<div class="actions">{data.projectUrl&&<a href={data.projectUrl} rel="noopener noreferrer">访问项目 <Icon name="arrowUpRight" size={16}/></a>}{data.repository&&<a href={data.repository} rel="noopener noreferrer">代码仓库 <Icon name="arrowUpRight" size={16}/></a>}</div>}</header>{data.cover&&<img class="cover" src={data.cover} alt=""/>}<div class="nf-prose"><slot /></div></article>
  <div class="back nf-reading"><a href={`${section.path}/`}><Icon name="arrowLeft" size={15}/> 返回{section.navLabel}</a></div>
</BaseLayout>
<style>
  .project { margin-top:2rem; padding:clamp(1.5rem,4vw,3.2rem); }
  header { margin-bottom:2rem; padding-bottom:2rem; border-bottom:1px solid var(--nf-line); }
  h1 { margin:.55rem 0 .8rem; font-size:clamp(2rem,4.5vw,3.45rem); line-height:1.12; letter-spacing:-.05em; }
  .dek { margin:0; color:var(--nf-muted); font-size:1.05rem; }
  .meta { display:flex; flex-wrap:wrap; gap:.4rem .8rem; margin-top:1rem; color:var(--nf-muted); font-size:.75rem; }
  .actions { display:flex; flex-wrap:wrap; gap:.6rem; margin-top:1.2rem; }
  .actions a { display:inline-flex; align-items:center; gap:.25rem; padding:.55rem .75rem; border-radius:.7rem; background:var(--nf-accent-soft); color:var(--nf-accent); font-size:.78rem; font-weight:700; text-decoration:none; }
  .cover { display:block; width:100%; height:auto; margin-bottom:2rem; border-radius:1rem; }
  .back { margin-top:1rem; }
  .back a { display:inline-flex; align-items:center; gap:.25rem; color:var(--nf-muted); font-size:.8rem; }
</style>
