---
import Icon from './Icon.astro';
const { project }=Astro.props;
const data=project.data;
const base=data.modulePath==='/'?'':data.modulePath;
---
<article class="project-card nf-card">
  {data.cover && <a class="cover" href={`${base}/${project.id}/`}><img src={data.cover} alt="" loading="lazy" /></a>}
  <div class="copy">
    <div class="meta">{data.projectType || 'Project'}{data.projectStatus && <span>{data.projectStatus}</span>}</div>
    <h2><a href={`${base}/${project.id}/`}>{data.title}</a></h2>
    <p>{data.description}</p>
    <a class="more" href={`${base}/${project.id}/`}>查看项目 <Icon name="arrowUpRight" size={16} /></a>
  </div>
</article>
<style>
  .project-card { overflow:hidden; box-shadow:none; transition:transform .18s ease, box-shadow .18s ease; }
  .project-card:hover { transform:translateY(-2px); box-shadow:var(--nf-shadow); }
  .cover { display:block; aspect-ratio:16/9; background:var(--nf-accent-soft); }
  .cover img { width:100%; height:100%; object-fit:cover; }
  .copy { padding:1.25rem; }
  .meta { display:flex; justify-content:space-between; gap:1rem; color:var(--nf-accent); font-size:.7rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
  h2 { margin:.5rem 0 .35rem; font-size:1.2rem; letter-spacing:-.025em; }
  h2 a { text-decoration:none; }
  p { margin:0; color:var(--nf-muted); font-size:.86rem; line-height:1.65; }
  .more { display:inline-flex; align-items:center; gap:.25rem; margin-top:1rem; color:var(--nf-accent); font-size:.8rem; font-weight:700; text-decoration:none; }
</style>
