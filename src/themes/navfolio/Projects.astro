---
import { site } from '../../site.config';
import BaseLayout from './BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
const { projects,section }=Astro.props;
---
<BaseLayout title={`${section.navLabel} · ${site.name}`} description={section.description}>
  <div class="projects-page nf-shell"><header class="nf-page-head nf-card"><p class="nf-kicker">{section.eyebrow}</p><h1>{section.heading}</h1>{section.description&&<p>{section.description}</p>}</header><section class="grid">{projects.length?projects.map(project=><ProjectCard project={project}/>):<p class="nf-empty nf-card">还没有公开项目。</p>}</section></div>
</BaseLayout>
<style>
  .projects-page { display:grid; gap:1rem; padding-top:2rem; }
  .grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; }
  .nf-empty { padding:1.5rem; }
  @media(max-width:52rem){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}} @media(max-width:34rem){.projects-page{padding-top:1rem}.grid{grid-template-columns:1fr}}
</style>
