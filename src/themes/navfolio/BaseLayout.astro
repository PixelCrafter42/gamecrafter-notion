---
import SEO from './SEO.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import './styles/global.css';
const { title, description, canonical, type, structuredData } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <SEO title={title} description={description} canonical={canonical} type={type} structuredData={structuredData} />
    <script is:inline>try { document.documentElement.dataset.theme=localStorage.getItem('gamecrafter-color-theme')||'system'; } catch { document.documentElement.dataset.theme='system'; }</script>
  </head>
  <body>
    <a class="skip" href="#content">跳到正文</a>
    <Header />
    <main id="content"><slot /></main>
    <Footer />
  </body>
</html>
<style>
  .skip { position:fixed; top:-5rem; left:1rem; z-index:100; padding:.55rem .8rem; border-radius:.7rem; background:var(--nf-ink); color:var(--nf-bg); }
  .skip:focus { top:1rem; }
</style>
