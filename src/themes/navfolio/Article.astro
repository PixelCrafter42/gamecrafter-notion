---
import { site } from '../../site.config';
import BaseLayout from './BaseLayout.astro';
import Icon from './Icon.astro';
const { post,previous,next,section }=Astro.props;
const data=post.data;
const structuredData={'@context':'https://schema.org','@type':'BlogPosting',headline:data.title,description:data.description,datePublished:data.pubDate.toISOString(),dateModified:(data.updatedDate??data.pubDate).toISOString(),author:{'@type':'Person',name:site.author.name},mainEntityOfPage:new URL(Astro.url.pathname,site.url).toString()};
---
<BaseLayout title={`${data.title} · ${site.name}`} description={data.description} type="article" structuredData={structuredData}>
  <article class="article nf-reading nf-card">
    <header><p class="nf-kicker">{section.eyebrow}</p><h1>{data.title}</h1><p class="dek">{data.description}</p><div class="meta"><time datetime={data.pubDate.toISOString()}>{data.pubDate.toLocaleDateString('zh-CN')}</time>{data.tags.map((tag:string)=><span>#{tag}</span>)}</div></header>
    <div class="nf-prose"><slot /></div>
  </article>
  <nav class="post-nav nf-reading" aria-label="文章导航"><div>{previous&&<><small>上一篇</small><a href={`${section.path}/${previous.id}/`}><Icon name="arrowLeft" size={15}/>{previous.data.title}</a></>}</div><div>{next&&<><small>下一篇</small><a href={`${section.path}/${next.id}/`}>{next.data.title}<Icon name="arrowRight" size={15}/></a></>}</div></nav>
</BaseLayout>
<style>
  .article { margin-top:2rem; padding:clamp(1.5rem,4vw,3.2rem); }
  header { margin-bottom:2rem; padding-bottom:2rem; border-bottom:1px solid var(--nf-line); }
  h1 { margin:.55rem 0 .8rem; font-size:clamp(2rem,4.5vw,3.45rem); line-height:1.12; letter-spacing:-.05em; }
  .dek { margin:0; color:var(--nf-muted); font-size:1.05rem; }
  .meta { display:flex; flex-wrap:wrap; gap:.4rem .8rem; margin-top:1rem; color:var(--nf-muted); font-size:.75rem; }
  .post-nav { display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-top:1rem; }
  .post-nav div { padding:1rem; }
  .post-nav div:last-child { text-align:right; }
  small { display:block; color:var(--nf-muted); font-size:.7rem; }
  .post-nav a { display:inline-flex; align-items:center; gap:.25rem; font-size:.84rem; font-weight:700; }
  @media(max-width:38rem){.post-nav{grid-template-columns:1fr}.post-nav div:last-child{text-align:left}}
</style>
