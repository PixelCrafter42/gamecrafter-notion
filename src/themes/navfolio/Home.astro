---
import { site } from '../../site.config';
import BaseLayout from './BaseLayout.astro';
import Icon from './Icon.astro';
import PostCard from './PostCard.astro';
import ProjectCard from './ProjectCard.astro';
import ThoughtCard from './ThoughtCard.astro';
const { posts, projects=[] }=Astro.props;
const all=[...posts,...projects];
const homeSections=site.sections.filter(section=>section.showOnHome && section.key!=='home').sort((a,b)=>a.navOrder-b.navOrder);
const navSections=site.sections.filter(section=>section.showInNav && section.path!=='/').sort((a,b)=>a.navOrder-b.navOrder);
const contentFor=section=>all.filter(item=>item.data.moduleKey===section.key).sort((a,b)=>Number(b.data.featured)-Number(a.data.featured)||b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,section.homeLimit||(section.layout==='项目网格'?3:5));
const iconFor=layout=>layout==='项目网格'?'grid':layout==='动态流'?'spark':layout==='普通页面'?'user':'pen';
---
<BaseLayout>
  <div class="dashboard nf-shell">
    <section class="intro nf-card">
      <p class="nf-kicker">Personal publication</p>
      <h1>{site.description}</h1>
      <p>{site.author.bio}</p>
    </section>
    <aside class="profile nf-card">
      {site.avatar && <img src={site.avatar.src} alt="" width="112" height="112" />}
      <h2>{site.author.name}</h2>
      <p>{site.author.bio}</p>
      <div class="social">{site.social.map(item=><a href={item.href} rel="me">{item.label}</a>)}{site.features.rss&&<a href="/rss.xml">RSS</a>}</div>
    </aside>
    <section class="navigation nf-card" aria-label="内容导航">
      {navSections.map(section=><a href={`${section.path}/`}><span class="nav-icon"><Icon name={iconFor(section.layout)} /></span><span><strong>{section.navLabel}</strong><small>{section.homeDescription||section.description||section.heading}</small></span><Icon name="arrowRight" /></a>)}
    </section>
    <div class="content-column">
      {homeSections.map(section=>{
        const items=contentFor(section);
        const count=all.filter(item=>item.data.moduleKey===section.key).length;
        return <section class="module nf-card">
          <header><div><p class="nf-kicker">{section.eyebrow||section.navLabel}</p><h2>{section.homeTitle||section.heading}</h2></div><a href={`${section.path}/`}>全部 {count} <Icon name="arrowRight" size={16} /></a></header>
          {section.layout==='普通页面'?<><p class="about-copy">{section.homeDescription||section.description}</p><a class="text-link" href={`${section.path}/`}>了解更多</a></>:section.layout==='项目网格'?(items.length?<div class="projects">{items.map(project=><ProjectCard project={project} />)}</div>:<p class="nf-empty">还没有公开项目。</p>):section.layout==='动态流'?(items.length?<div>{items.map(thought=><ThoughtCard thought={thought} compact />)}</div>:<p class="nf-empty">还没有公开想法。</p>):(items.length?<div>{items.map((post,index)=><PostCard post={post} index={index} />)}</div>:<p class="nf-empty">还没有公开内容。</p>)}
        </section>;
      })}
    </div>
  </div>
</BaseLayout>
<style>
  .dashboard { display:grid; grid-template-columns:minmax(0,1fr) 18rem; gap:1.25rem; padding-top:2rem; align-items:start; }
  .intro { padding:2.2rem; }
  .intro h1 { margin:.65rem 0 .8rem; max-width:40rem; font-size:clamp(2rem,4.2vw,3.35rem); line-height:1.12; letter-spacing:-.05em; }
  .intro > p:last-child { margin:0; color:var(--nf-muted); }
  .profile { grid-column:2; grid-row:1; padding:1.5rem; text-align:center; }
  .profile img { width:7rem; height:7rem; object-fit:cover; border-radius:50%; }
  .profile h2 { margin:.8rem 0 .15rem; font-size:1.15rem; }
  .profile p { margin:0; color:var(--nf-muted); font-size:.82rem; }
  .social { display:flex; justify-content:center; flex-wrap:wrap; gap:.65rem; margin-top:1rem; }
  .social a { color:var(--nf-accent); font-size:.72rem; }
  .navigation { grid-column:2; grid-row:2; padding:.75rem 1.1rem; box-shadow:none; }
  .navigation > a { display:grid; grid-template-columns:1.8rem minmax(0,1fr) 1rem; gap:.65rem; align-items:center; padding:.75rem 0; border-bottom:1px solid var(--nf-line); text-decoration:none; }
  .navigation > a:last-child { border-bottom:0; }
  .navigation > a:hover { color:var(--nf-accent); }
  .nav-icon { display:grid; place-items:center; color:var(--nf-accent); }
  .navigation strong,.navigation small { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .navigation strong { font-size:.88rem; }
  .navigation small { margin-top:.1rem; color:var(--nf-muted); font-size:.7rem; }
  .content-column { display:grid; grid-column:1; grid-row:2 / span 2; gap:1.25rem; }
  .module { padding:1.6rem 1.8rem; }
  .module > header { display:flex; justify-content:space-between; align-items:end; gap:1rem; margin-bottom:1rem; }
  .module h2 { margin:.25rem 0 0; font-size:1.35rem; letter-spacing:-.025em; }
  .module > header > a { display:inline-flex; align-items:center; gap:.25rem; color:var(--nf-muted); font-size:.75rem; text-decoration:none; }
  .projects { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.8rem; }
  .about-copy { color:var(--nf-muted); }
  .text-link { color:var(--nf-accent); font-size:.82rem; font-weight:700; }
  @media(max-width:54rem) { .dashboard { grid-template-columns:1fr; } .intro,.profile,.navigation,.content-column { grid-column:1; grid-row:auto; } .profile { display:grid; grid-template-columns:auto 1fr; column-gap:1rem; text-align:left; } .profile img { grid-row:1/4; width:5rem; height:5rem; } .profile h2 { align-self:end; margin:0; } .social { justify-content:flex-start; margin-top:.4rem; } }
  @media(max-width:38rem) { .dashboard { padding-top:1rem; } .intro,.module { padding:1.35rem; } .projects { grid-template-columns:1fr; } }
</style>
