---
import Icon from './Icon.astro';
const { thought, compact=false, detail=false }=Astro.props;
const data=thought.data;
const base=data.modulePath==='/'?'':data.modulePath;
const href=`${base}/${thought.id}/`;
const options:Intl.DateTimeFormatOptions=data.publishedHasTime?{year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hour12:false}:{year:'numeric',month:'2-digit',day:'2-digit'};
---
<article class:list={['thought',{compact,detail}]}>
  <header><time datetime={data.pubDate.toISOString()}>{data.pubDate.toLocaleString('zh-CN',options)}</time>{data.tags.map((tag:string)=><span>#{tag}</span>)}</header>
  {detail?<h1>{data.title}</h1>:<h2><a href={href}>{data.title}</a></h2>}
  {data.description && data.description!==data.title && <p>{data.description}</p>}
  {!compact && data.html && <div class="nf-prose body" set:html={data.html} />}
  {!detail && <a class="permalink" href={href}>打开 <Icon name="arrowUpRight" size={15} /></a>}
</article>
<style>
  .thought { padding:1.35rem 0; border-bottom:1px solid var(--nf-line); }
  .thought:last-child { border-bottom:0; }
  header { display:flex; flex-wrap:wrap; gap:.4rem .75rem; margin-bottom:.55rem; color:var(--nf-muted); font-size:.7rem; }
  header time { color:var(--nf-accent); font-family:ui-monospace,monospace; }
  h1,h2 { margin:0; font-size:clamp(1.05rem,2vw,1.25rem); line-height:1.58; letter-spacing:-.015em; }
  h2 a { text-decoration:none; }
  h2 a:hover { color:var(--nf-accent); }
  p { margin:.4rem 0 0; color:var(--nf-muted); font-size:.88rem; }
  .body { margin-top:1rem; }
  .permalink { display:inline-flex; align-items:center; gap:.2rem; margin-top:.8rem; color:var(--nf-muted); font-size:.72rem; text-decoration:none; }
  .permalink:hover { color:var(--nf-accent); }
  .compact { padding:1rem 0; }
  .detail { padding-top:0; border:0; }
</style>
