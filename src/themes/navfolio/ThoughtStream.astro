---
import { site } from '../../site.config';
import BaseLayout from './BaseLayout.astro';
import ThoughtCard from './ThoughtCard.astro';
const { thoughts,section }=Astro.props;
---
<BaseLayout title={`${section.navLabel} · ${site.name}`} description={section.description}>
  <div class="thoughts nf-reading"><header class="nf-page-head nf-card"><p class="nf-kicker">{section.eyebrow}</p><h1>{section.heading}</h1>{section.description&&<p>{section.description}</p>}</header><section class="stream nf-card" aria-label={section.navLabel}>{thoughts.length?thoughts.map(thought=><ThoughtCard thought={thought}/>):<p class="nf-empty">还没有公开想法。</p>}</section></div>
</BaseLayout>
<style>
  .thoughts { display:grid; gap:1rem; padding-top:2rem; }
  .stream { padding:1rem 1.8rem; }
  @media(max-width:42rem){.thoughts{padding-top:1rem}.stream{padding:.7rem 1.3rem}}
</style>
