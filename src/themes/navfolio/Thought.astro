---
import { site } from '../../site.config';
import BaseLayout from './BaseLayout.astro';
import Icon from './Icon.astro';
import ThoughtCard from './ThoughtCard.astro';
const { thought,section }=Astro.props;
---
<BaseLayout title={`${thought.data.title} · ${site.name}`} description={thought.data.description||thought.data.title} type="article"><main class="thought nf-reading nf-card"><ThoughtCard thought={thought} detail /></main><div class="back nf-reading"><a href={`${section.path}/`}><Icon name="arrowLeft" size={15}/> 返回{section.navLabel}</a></div></BaseLayout>
<style>
  .thought { margin-top:2rem; padding:clamp(1.5rem,4vw,3rem); }
  .back { margin-top:1rem; }
  .back a { display:inline-flex; align-items:center; gap:.25rem; color:var(--nf-muted); font-size:.8rem; }
</style>
