---
import { getCollection } from 'astro:content';
import { Archive, Article, ContentPage, Project, Projects } from '../theme';
import { site } from '../site.config';
import { buildSectionPaths } from '../section-routes.mjs';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
  const projects = (await getCollection('projects', ({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
  return buildSectionPaths({sections:site.sections,posts,projects});
}

const { view, section, item, items = [] } = Astro.props;
const index = item ? items.findIndex(entry=>entry.id === item.id) : -1;
const previous = index >= 0 ? items[index + 1] : undefined;
const next = index >= 0 ? items[index - 1] : undefined;
---
{view === 'archive' && <Archive posts={items} section={section} />}
{view === 'article' && <Article post={item} previous={previous} next={next} section={section}><Fragment set:html={item.data.html} /></Article>}
{view === 'projects' && <Projects projects={items} section={section} />}
{view === 'project' && <Project project={item} section={section}><Fragment set:html={item.data.html} /></Project>}
{view === 'page' && <ContentPage eyebrow={section.eyebrow} heading={section.heading} intro={section.description}><Fragment set:html={section.html} /></ContentPage>}
