---
import { type CollectionEntry, getCollection } from 'astro:content';
import { Article } from '../../theme';
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({data})=>!data.draft);
  return posts.map(post=>({params:{slug:post.id},props:post}));
}
type Props = CollectionEntry<'blog'>;
const post = Astro.props;
const posts = (await getCollection('blog', ({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const index = posts.findIndex(item => item.id === post.id);
const previous = posts[index + 1];
const next = posts[index - 1];
---
<Article post={post} previous={previous} next={next}><Fragment set:html={post.data.html} /></Article>
